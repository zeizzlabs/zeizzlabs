# ZeizzLabs — environment variables (all optional; safe defaults exist)
# Copy to .env.local and fill in what you have.

# Canonical production URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://zeizzlabs.com

# Public contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=enquire@zeizzlabs.com
NEXT_PUBLIC_CONTACT_EMAIL_ALT=zeizzlabs@gmail.com
#NEXT_PUBLIC_CONTACT_EMAIL_UNUSED=hello@zeizzlabs.com

# Social profile URLs — only ones you set are shown in the footer
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=

# Contact form email delivery (Resend). Without RESEND_API_KEY the form
# validates and logs server-side but does not send email.
RESEND_API_KEY=
# Comma-separated. Defaults to both business inboxes.
CONTACT_TO=enquire@zeizzlabs.com,zeizzlabs@gmail.com
CONTACT_FROM="ZeizzLabs <onboarding@resend.dev>"
